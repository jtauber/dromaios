cpu "8008"
state {
  register A: 8
  flag C
  array ADDRESS: 14[8] = addressStack
  latch STOPPED = halted
  choice WAIT: "none", "sync", "cwai" = waitMode
}
view PC "PC and \"quoted\" // text": 14 {
  slot = register SELECTOR
  address = array ADDRESS[slot]
  return address
}
action reset "reset" {
  ADDRESS[] <- u14($0000)
  STOPPED <- 1
}
policy ALU "carry" (result: 8, carry: flag) {
  C = carry
  V = addOverflow(result, result, carry)
  N = overflow(result, result)
}
operands bytes {
  000 "A" = register A
  001 "M" = memory throughHL
  010 "B" = pair B C
}
codes vectors: 14 {
  000 "00" = $00
}
conditions branches {
  000 "FC" = flag C = 0
}
family transfer "11 ddd sss" for d in bytes, s in bytes named "L{d}{s}" except "11 111 111" {
  source = operand s
  operand d <- source // This remains a comment: $FF "text"
}
family AD {
  encoding "10 000 sss" for s in bytes.read named "AD{s}"
  encoding "00 000 100" with s = immediateByte named "ADI byte"
  right = source s
  carry = flag C
  left = register A
  shifted = shiftBits(left, right, 4)
  notify reti
  product = multiply(left, right)
  result = add(left, right, carry)
  apply ALU(result, carry(left, right, carry))
  replace ALU(select(carry, u8(1), u8(0)), or(carry, 0))
  A <- result
  PC <- signExtend(result, 16)
}
family conditional "01 ccc 000" for c in branches {
  when test c {
    when not(zero(address)) {
      ADDRESS[slot] <- truncate(address, 14)
    }
  }
}
family load "0011 ddd 000 010 rrr" for d in dataRegisters, r in addressRegisters {
  code = operand r
  address = resolve(16, u3(2), code)
  fault alignment read(address) if lowBit(address)
  high = memory(address)
  low = port(u16($08))
  commit addresses
  memory(address) <- high
  port(address) <- low
}
execution {
  memory 14
  counter PC write setPC
  stopped STOPPED
  word little
  opcode advance on dispatch
  operand advance after read
  failure retain
  reset action reset
  retire none
  interrupt {
    accept always with resume
    bytes acknowledge
    counter preserve
    unknown retain
  }
}
interface Cpu8008 "Public interface" {
  snapshot pc = PC
}

// Recognition and retirement syntax used by the 8080 chapter.
action enable "request deferral" {
  ENABLED <- 1
  defer irq
}
execution {
  retire irq into DEFERRED
  interrupt {
    accept when ENABLED unless DEFERRED with resume
    callback validate on read
  }
}

family enable8088 "00000000" {
  defer intr
  defer all
}

// Memory actions and named vector entry, without a synthetic stopped latch.
action vectorReset "reset from memory" using memory {
  low = memory(u16($FFFC))
  PC <- extend(low, 16)
}
execution {
  stopped WAITING as waiting
  interrupt vectors {
    source irq unless flag I with enter($FFFE)
    source nmi always with enter($FFFA)
  }
}

// Reusable effects are statements, with typed argument expressions.
action prepare "reset before entry" {
  perform reset()
}
action enter "write an entry byte" (address: 16, byte: 8) using memory {
  memory(address) <- byte
}
family trap "11 111 111" {
  perform prepare()
  perform enter(u16($1000), u8($80))
}

// Postbyte matching yields a value or stops the instruction.
source address "decoded address": 16 {
  postbyte = fetch
  result = match postbyte: 16 {
    case "0 rr xxxxx" for r in registers {
      base = operand r
      return base
    }
    otherwise unsupported
  }
  return result
}

page secondary = $10
family prefixed "0010 0001" on secondary {
  byte = fetch
}

operands statusViews {
  0 "status" = view CC write restoreCC
  1 "reserved" = unsupported
}
family choiceProbe "1111 1111" {
  waiting = choice WAIT = "sync"
  WAIT <- "none"
  postbyte = fetch
  match postbyte {
    case "0000 000 r" for r in statusViews {
      value = operand r
      operand r <- value
    }
    otherwise unsupported
  }
}

execution {
  stopped choice WAIT unless "none" as waiting
  interrupt vectors {
    source irq unless flag I with enter($FFF8) resume when choice WAIT = "sync" with resumeSync()
    source nmi when latch ENABLED otherwise "unarmed" with enter($FFFC)
  }
}

state {
  bank ALTERNATE = alternate {
    register B: 8
    flag C
  }
  choice MODE: 0, 1, 2
}
action banked "qualified bank and numeric choice" {
  other = register ALTERNATE.B
  saved = flag ALTERNATE.C
  ALTERNATE.B <- other
  MODE <- 2
  enabled = choice MODE = 2
}

action exchangeBanks "preserve complete flag objects" {
  exchange FLAGS, ALTERNATE.FLAGS
  exchange = u8(0)
}

execution {
  interrupt entries {
    source irq acknowledge {
      when latch ENABLED otherwise "disabled"
      accept action resume
      select MODE {
        case 0 supplied
        case 1 action enterVector
      }
    }
    source nmi {
      accept action resume
      enter action enterVector
    }
  }
}
interface CpuZ80 "bank views" {
  bank RegisterBank = alternate snapshot BankSnapshot
  snapshot alternate.bc = BC_ALT
}

// Numeric inputs connect captured address values without hidden state fields.
source projected "segmented byte" (segment: 16, offset: 16): 8 {
  byte = memory(projectAddress(segment, offset, 4, 20))
  return byte
}
family segmented (segment: 16) "10001000" {
  byte = source projected(segment, u16($FFFF))
  A <- byte
}

family bounded "11111110" {
  result = iterate(u8(2), u8(1)) {
    return add(result, u8(1))
  }
  quotient, remainder = divide(u16(12), result, signed) otherwise "division"
  reject "division" if zero(quotient)
  W <- multiply(quotient, remainder, unsigned)
}

// Boundary capabilities are checked by the chapter compiler, including nested calls.
action device "captured device effects" (vector: 8) using memory, boundary {
  high = sample test
  send escape(vector, u8(0))
  send escape(vector, u8(0)) with memory(u16(0), u16(0), projectAddress(u16(0), u16(0), 4, 20), u16(0))
  report interrupt(vector)
}

execution segmented {
  segment CS shift 4
  record address PC
  fetch action advanceIP
  prefixes limit 65536 {
    segment $26 ES
    ignore $F0
    repeat $F3 1
  }
  waiting WAITING with pollWait(1)
  pending "trap" vector 1 when TRAPPENDING unless RECOGNITIONDEFERRED with beginTrap then enterInterrupt
  fault "divide-error" vector 0 with enterInterrupt
  retire action finish sampling flag TF, latch TRAPPENDING
  unsupported restore counter
}
