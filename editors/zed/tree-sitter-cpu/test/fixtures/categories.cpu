cpu "8008"
state {
  register A: 8
  flag C
  array ADDRESS: 14[8] = addressStack
  latch STOPPED = halted
  choice WAIT: "none", "sync", "cwai" = waitMode
}
view PC "PC and \"quoted\" // text": 14 {
  slot = register SELECTOR
  address = array ADDRESS[slot]
  return address
}
action reset "reset" {
  ADDRESS[] <- u14($0000)
  STOPPED <- 1
}
policy ALU "carry" (result: 8, carry: flag) {
  C = carry
  V = addOverflow(result, result, carry)
  N = overflow(result, result)
}
operands bytes {
  000 "A" = register A
  001 "M" = memory throughHL
  010 "B" = pair B C
}
codes vectors: 14 {
  000 "00" = $00
}
conditions branches {
  000 "FC" = flag C = 0
}
family transfer "11 ddd sss" for d in bytes, s in bytes named "L{d}{s}" except "11 111 111" {
  source = operand s
  operand d <- source // This remains a comment: $FF "text"
}
family AD {
  encoding "10 000 sss" for s in bytes.read named "AD{s}"
  encoding "00 000 100" with s = immediateByte named "ADI byte"
  right = source s
  carry = flag C
  left = register A
  product = multiply(left, right)
  result = add(left, right, carry)
  apply ALU(result, carry(left, right, carry))
  replace ALU(select(carry, u8(1), u8(0)), or(carry, 0))
  A <- result
  PC <- signExtend(result, 16)
}
family conditional "01 ccc 000" for c in branches {
  when test c {
    when not(zero(address)) {
      ADDRESS[slot] <- truncate(address, 14)
    }
  }
}
family load "0011 ddd 000 010 rrr" for d in dataRegisters, r in addressRegisters {
  code = operand r
  address = resolve(16, u3(2), code)
  fault alignment read(address) if lowBit(address)
  high = memory(address)
  low = port(u16($08))
  commit addresses
  memory(address) <- high
  port(address) <- low
}
execution {
  memory 14
  counter PC write setPC
  stopped STOPPED
  word little
  opcode advance on dispatch
  operand advance after read
  failure retain
  reset action reset
  retire none
  interrupt {
    accept always with resume
    bytes acknowledge
    counter preserve
    unknown retain
  }
}
interface Cpu8008 "Public interface" {
  snapshot pc = PC
}

// Recognition and retirement syntax used by the 8080 chapter.
action enable "request deferral" {
  ENABLED <- 1
  defer irq
}
execution {
  retire irq into DEFERRED
  interrupt {
    accept when ENABLED unless DEFERRED with resume
    callback validate on read
  }
}

// Memory actions and named vector entry, without a synthetic stopped latch.
action vectorReset "reset from memory" using memory {
  low = memory(u16($FFFC))
  PC <- extend(low, 16)
}
execution {
  stopped WAITING as waiting
  interrupt vectors {
    source irq unless flag I with enter($FFFE)
    source nmi always with enter($FFFA)
  }
}

// Reusable effects are statements, with typed argument expressions.
action prepare "reset before entry" {
  perform reset()
}
action enter "write an entry byte" (address: 16, byte: 8) using memory {
  memory(address) <- byte
}
family trap "11 111 111" {
  perform prepare()
  perform enter(u16($1000), u8($80))
}

// Postbyte matching yields a value or stops the instruction.
source address "decoded address": 16 {
  postbyte = fetch
  result = match postbyte: 16 {
    case "0 rr xxxxx" for r in registers {
      base = operand r
      return base
    }
    otherwise unsupported
  }
  return result
}

page secondary = $10
family prefixed "0010 0001" on secondary {
  byte = fetch
}

operands statusViews {
  0 "status" = view CC write restoreCC
  1 "reserved" = unsupported
}
family choiceProbe "1111 1111" {
  waiting = choice WAIT = "sync"
  WAIT <- "none"
  postbyte = fetch
  match postbyte {
    case "0000 000 r" for r in statusViews {
      value = operand r
      operand r <- value
    }
    otherwise unsupported
  }
}

execution {
  stopped choice WAIT unless "none" as waiting
  interrupt vectors {
    source irq unless flag I with enter($FFF8) resume when choice WAIT = "sync" with resumeSync()
    source nmi when latch ENABLED otherwise "unarmed" with enter($FFFC)
  }
}

state {
  bank ALTERNATE = alternate {
    register B: 8
    flag C
  }
  choice MODE: 0, 1, 2
}
action banked "qualified bank and numeric choice" {
  other = register ALTERNATE.B
  saved = flag ALTERNATE.C
  ALTERNATE.B <- other
  MODE <- 2
  enabled = choice MODE = 2
}
