// Process four bytes through nested calls; replace an incremented zero with one.
ram 1000000

cpu 68000 {
  D0 = 11223344  D1 = 55667788  D2 = 99AABBCC  D3 = DDEEFF00
  D4 = 01234567  D5 = 89ABCDEF  D6 = FEDCBA98  D7 = 76543210
  A0 = 10000000  A1 = 20000000  A2 = 30000000  A3 = 40000000
  A4 = 50000000  A5 = 60000000  A6 = 70000000
  USP = 34008000  SSP = 56009000  PC = AB002000
  interruptMask = 2
  flags { X = 1  N = 0  Z = 1  V = 1  C = 1  T = 0  S = 0 }
}

memory 000000 { 56 00 90 00  AB 00 20 00 }

memory 002000 {
  20 7C AB 00 30 00  // MOVEA.L #AB003000,A0
  22 3C 12 34 00 03  // MOVE.L #12340003,D1: low-word count = iterations minus one
  74 00              // MOVEQ #0,D2: count processed bytes
  61 00 00 30        // BSR.W process (2040); save full return address AB002012
  23 C2 CD 00 40 00  // MOVE.L D2,(CD004000).L
  60 00 00 66        // BRA.W finished (2080)
}

memory 002040 {
  61 1E              // process: BSR.B transform (2060); save AB002042
  06 42 00 01        // ADDI.W #1,D2
  51 C9 FF F8        // DBF D1,process: branch until D1.W becomes FFFF; preserve flags
  4E 75              // RTS
}

memory 002060 {
  06 10 00 01        // transform: ADDI.B #1,(A0)
  66 04              // BNE.B readback (206A)
  00 10 00 01        // ORI.B #1,(A0): replace a zero result with one
  10 18              // readback: MOVE.B (A0)+,D0
  4E 75              // RTS
}

memory 002FFE { DE AD  00 7F FF FE  BE EF }
memory 003FFE { DE AD  CC CC CC CC  BE EF }
memory 007FF6 { DE AD  CC CC CC CC CC CC CC CC  BE EF }
memory 008FF6 { DE AD  CC CC CC CC CC CC CC CC  BE EF }

end AB002080
