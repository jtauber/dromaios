// Unpack tagged signed samples, scale them, and shift a two-word value through X.
ram 1000000

cpu 68000 {
  D0 = 11223344  D1 = 55667788  D2 = 99AABBCC  D3 = DDEEFF00
  D4 = 01234567  D5 = 89ABCDEF  D6 = FEDCBA98  D7 = 76543210
  A0 = 10000000  A1 = 20000000  A2 = 30000000  A3 = 40000000
  A4 = 50000000  A5 = 60000000  A6 = 70000000
  USP = 34008000  SSP = 56009000  PC = AB002000
  interruptMask = 2
  flags { X = 1  N = 0  Z = 1  V = 1  C = 1  T = 0  S = 0 }
}

memory 000000 { 56 00 90 00  AB 00 20 00 }

memory 002000 {
  41 F9 AB 00 30 00  // LEA (AB003000).L,A0: packed tag/sample pairs
  43 F9 CD 00 40 00  // LEA (CD004000).L,A1: scaled sample and shifted tag words
  7E 01              // MOVEQ #1,D7: DBF runs the loop twice
  30 18              // loop (200E): MOVE.W (A0)+,D0
  E1 58              // ROL.W #8,D0: bring the tag into the low byte
  72 00              // MOVEQ #0,D1
  12 00              // MOVE.B D0,D1: extract the tag
  E0 58              // ROR.W #8,D0: restore the packed sample
  E1 48              // LSL.W #8,D0: discard the tag, move the sample sign to bit 15
  E0 40              // ASR.W #8,D0: sign-extend the sample into a word
  E3 40              // ASL.W #1,D0: double the signed sample
  32 C0              // MOVE.W D0,(A1)+
  E2 09              // LSR.B #1,D1: discard the tag's low bit
  32 C1              // MOVE.W D1,(A1)+
  51 CF FF E8        // DBF D7,200E
  45 F9 EF 00 60 02  // LEA (EF006002).L,A2: low word of a two-word value
  E3 D2              // LSL.W (A2): low word -> X
  E5 E2              // ROXL.W -(A2): X -> high word, completing a 32-bit left shift
  E2 DA              // LSR.W (A2)+: high word -> X
  E4 D2              // ROXR.W (A2): X -> low word, restoring the original value
}

memory 002FFE { DE AD  81 80 12 34  BE EF }
memory 003FFE { DE AD  CC CC CC CC CC CC CC CC  BE EF }
memory 005FFE { DE AD  40 01 80 01  BE EF }

end AB002036
