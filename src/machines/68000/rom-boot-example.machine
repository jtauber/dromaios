// ROM boot and recovery from an unmapped read.

components {
    rom = rom 0400
    ram = ram 1000
}

cpu 68000 {
    D0 = 00000000  D1 = 00000000  D2 = 00000000  D3 = 00000000
    D4 = 00000000  D5 = 00000000  D6 = 00000000  D7 = 00000000
    A0 = 00000000  A1 = 00000000  A2 = 00000000  A3 = 00000000
    A4 = 00000000  A5 = 00000000  A6 = 00000000
    USP = 00000000  SSP = 00000000  PC = 00000000  IR = 0000
    interruptMask = 0
    halted = false  faulted = false  tracePending = false
    entry { kind = none  vector = 00 }
    flags { X = 0  N = 0  Z = 0  V = 0  C = 0  T = 0  S = 0 }
}

map 1000000 {
    000000 = rom
    010000 = ram
}

image rom 000000 {
    00 01 10 00         // Initial SSP: 011000, just above RAM.
    00 00 01 00         // Initial PC: 000100, in ROM.
    00 00 02 00         // Vector 2: 000200, the bus-error handler.
}

image rom 000100 {
    20 3C 12 34 56 78   // 0100: MOVE.L #12345678,D0
    23 C0 00 01 00 00   // 0106: MOVE.L D0,(010000).L
    22 39 00 02 00 00   // 010C: MOVE.L (020000).L,D1 — unmapped.
    23 C0 00 01 00 04   // 0112: MOVE.L D0,(010004).L — resumed.
    4E 72 27 00         // 0118: STOP #2700
}

image rom 000200 {
    24 2F 00 02         // 0200: MOVE.L 2(A7),D2 — fault address.
    23 C2 00 01 00 08   // 0204: MOVE.L D2,(010008).L
    72 01               // 020A: MOVEQ #1,D1 — handled marker.
    50 8F               // 020C: ADDQ.L #8,A7 — discard extra frame bytes.
    4E 73               // 020E: RTE — resume at the saved fetch cursor.
}
