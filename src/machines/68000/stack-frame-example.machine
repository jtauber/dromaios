// Pass a word-array pointer to a subroutine with local storage and saved registers.
ram 1000000

cpu 68000 {
  D0 = 11223344  D1 = 55667788  D2 = 99AABBCC  D3 = DDEEFF00
  D4 = 01234567  D5 = 89ABCDEF  D6 = FEDCBA98  D7 = 76543210
  A0 = 10000000  A1 = 20000000  A2 = 30000000  A3 = 40000000
  A4 = 50000000  A5 = 60000000  A6 = 70000000
  USP = 34008000  SSP = 56009000  PC = AB002000
  halted = false
  interruptMask = 2
  flags { X = 1  N = 0  Z = 1  V = 1  C = 1  T = 0  S = 0 }
}

memory 000000 { 56 00 90 00  AB 00 20 00 }

memory 002000 {
  41 FA 0F FE        // LEA (0FFE,PC),A0: AB003000
  48 50              // PEA (A0): pass the pointer on the active stack
  4E BA 00 38        // JSR (0038,PC): call AB002040
  DE FC 00 04        // ADDA.W #4,A7: discard the argument after return
  43 FA 00 10        // LEA (0010,PC),A1: AB002020
  4E D1              // JMP (A1): reach the logical endpoint
}

memory 002040 {
  4E 56 FF F8        // LINK A6,#-8: establish a frame with eight local bytes
  48 E7 60 80        // MOVEM.L D1-D2/A0,-(A7): reversed register mask
  20 6E 00 08        // MOVEA.L (8,A6),A0: the caller's pointer argument
  4C 98 00 06        // MOVEM.W (A0)+,D1-D2: sign-extend both input words
  D4 81              // ADD.L D1,D2: 32767 + (-32768) = -1
  2D 42 FF FC        // MOVE.L D2,(-4,A6): store a local result
  20 2E FF FC        // MOVE.L (-4,A6),D0: return it in D0
  4C DF 01 06        // MOVEM.L (A7)+,D1-D2/A0: normal register mask
  4E 5E              // UNLK A6: restore caller's frame pointer
  4E 75              // RTS
}

memory 002FFE { DE AD  7F FF 80 00  BE EF }

end AB002020
