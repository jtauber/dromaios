// Transform mixed-size RAM fields, then compare and read back the results.
ram 1000000

cpu 68000 {
  D0 = 11223344  D1 = 55667788  D2 = 99AABBCC  D3 = DDEEFF00
  D4 = 01234567  D5 = 89ABCDEF  D6 = FEDCBA98  D7 = 76543210
  A0 = 10000000  A1 = 20000000  A2 = 30000000  A3 = 40000000
  A4 = 50000000  A5 = 60000000  A6 = 70000000
  USP = 34008000  SSP = 56009000  PC = AB002000
  interruptMask = 2
  flags { X = 1  N = 0  Z = 1  V = 1  C = 1  T = 0  S = 0 }
}

memory 000000 { 56 00 90 00  AB 00 20 00 }

memory 002000 {
  20 7C AB 00 30 00  // MOVEA.L #AB003000,A0
  06 18 00 01        // ADDI.B #1,(A0)+: 7F -> 80, signed overflow
  04 18 00 01        // SUBI.B #1,(A0)+: 00 -> FF, borrow sets X and C
  02 50 0F FF        // ANDI.W #0FFF,(A0): ABCD -> 0BCD
  00 58 80 00        // ORI.W #8000,(A0)+: 0BCD -> 8BCD, preserve X
  0A 90 FF FF FF FF  // EORI.L #FFFFFFFF,(A0): 11223344 -> EEDDCCBB
  04 90 00 00 00 01  // SUBI.L #1,(A0): EEDDCCBB -> EEDDCCBA
  06 98 11 22 33 46  // ADDI.L #11223346,(A0)+: zero with carry
  0C A0 00 00 00 00  // CMPI.L #0,-(A0): equal, update A0 without a write
  20 20              // MOVE.L -(A0),D0: read back 80FF8BCD
  02 80 00 FF FF FF  // ANDI.L #00FFFFFF,D0: 00FF8BCD
  0A 00 00 FF        // EORI.B #FF,D0: 00FF8B32, preserve upper bytes
  00 40 80 00        // ORI.W #8000,D0: 00FF8B32, set N from the word
  06 40 74 CE        // ADDI.W #74CE,D0: 00FF0000, word carry
  0C 18 00 01        // CMPI.B #1,(A0)+: 80 - 1 overflows, preserve X
  0C 18 00 FF        // CMPI.B #FF,(A0)+: equal, no memory write
}

memory 002FFE { DE AD  7F 00 AB CD 11 22 33 44  BE EF }

end AB00204A
