// Send HELLO and newline to a host-bound byte output.

components {
    rom = rom 0400
    ram = ram 1000
    output = byte-output
}

cpu 68000 {
    D0 = 00000000  D1 = 00000000  D2 = 00000000  D3 = 00000000
    D4 = 00000000  D5 = 00000000  D6 = 00000000  D7 = 00000000
    A0 = 00000000  A1 = 00000000  A2 = 00000000  A3 = 00000000
    A4 = 00000000  A5 = 00000000  A6 = 00000000
    USP = 00000000  SSP = 00000000  PC = 00000000  IR = 0000
    interruptMask = 0
    halted = false  faulted = false  tracePending = false
    entry { kind = none  vector = 00 }
    flags { X = 0  N = 0  Z = 0  V = 0  C = 0  T = 0  S = 0 }
}

map 1000000 {
    000000 = rom
    010000 = ram
    020000 = output
}

image rom 000000 {
    00 01 10 00         // Initial SSP: 011000, just above RAM.
    00 00 01 00         // Initial PC: 000100, in ROM.
    00 00 02 00         // Vector 2: 000200, a stopping fault handler.
}

image rom 000100 {
    4E 70               // 0100: RESET — clear the device, preserving CPU state and RAM.
    41 F9 00 00 01 80   // 0102: LEA (000180).L,A0 — message in ROM.
    43 F9 00 02 00 00   // 0108: LEA (020000).L,A1 — output register.
    70 05               // 010E: MOVEQ #5,D0 — six iterations of DBF.
    12 98               // 0110: MOVE.B (A0)+,(A1)
    51 C8 FF FC         // 0112: DBF D0,0110
    4E 72 27 00         // 0116: STOP #2700
}

image rom 000180 {
    48 45 4C 4C 4F 0A
} // HELLO\n

image rom 000200 {
    4E 72 27 00
} // Stop after an unexpected bus error.

reset-devices { output }
