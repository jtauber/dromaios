ram 10000

cpu 6502 {
    A = 00  X = 00  Y = 00
    PC = 0200  SP = FF
    flags { N = 0  V = 0  D = 0  I = 1  Z = 0  C = 1 }
}

memory 0200 {
    18          // CLC
    A9 02       // LDA #2
    69 03       // ADC #3
    8D 80 00    // STA $0080
}

memory FFFC {
    00 02       // Reset vector: 0200, low byte first
}

end 0208
