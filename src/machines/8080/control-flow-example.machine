ram 10000

cpu 8080 {
    A = 11  B = 22  C = 33  D = 44
    E = 55  H = 66  L = 77
    PC = 0000  SP = 2000
    flags { S = 1  Z = 0  AC = 1  P = 0  CY = 1 }
    interruptEnabled = false
    interruptDeferred = false
    halted = false
}

memory 0000 {
    3E FE       // MVI A,FEH
    CD 10 00    // CALL 0010H
    C2 02 00    // JNZ 0002H
    32 80 00    // STA 0080H
    76          // HLT
}

memory 0010 {
    C6 01       // ADI 01H
    C9          // RET
}

memory 0080 { A5 } // Make the final zero store visible.
