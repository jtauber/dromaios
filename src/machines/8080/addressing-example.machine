ram 10000

cpu 8080 {
    A = 11  B = 22  C = 33  D = 44
    E = 55  H = 66  L = 77
    PC = 0000  SP = ABCD
    flags { S = 1  Z = 0  AC = 1  P = 0  CY = 1 }
    interruptEnabled = false
    interruptDeferred = false
    halted = false
}

memory 0000 {
    21 FF 12    // LXI H,12FFH
    7E          // MOV A,M
    23          // INX H
    77          // MOV M,A
    76          // HLT
}

memory 12FF { A5 }
