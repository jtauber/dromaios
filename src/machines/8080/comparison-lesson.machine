ram 10000

cpu 8080 {
    A = 00  B = 00  C = 00  D = 00  E = 00  H = 00  L = 00
    PC = 0100  SP = 0000
    flags { S = 0  Z = 0  AC = 0  P = 0  CY = 0 }
    interruptEnabled = false
    interruptDeferred = false
    halted = false
}

memory 0003 { 29 00 }   // Start at 41; address 4 receives 42, 43, then 44.

memory 0100 {
    3A 03 00           // 0100: LDA 0003H: load the starting value once.
    C6 01              // 0103: ADI 1: add one and update flags.
    32 04 00           // 0105: STA 0004H: store the result, preserving flags.
    FE 2C              // 0108: CPI 44: compare with the target, preserving A.
    C2 03 01           // 010A: JNZ 0103H: repeat while the values differ.
}

end 010D              // The lesson ends when JNZ falls through; no HLT runs.
