ram 10000

cpu 8080 {
    A = 00  B = 00  C = 00  D = 00  E = 00  H = 00  L = 00
    PC = 0100  SP = 0000
    flags { S = 0  Z = 0  AC = 0  P = 0  CY = 0 }
    interruptEnabled = false
    interruptDeferred = false
    halted = false
}

memory 0003 { FE 00 }   // Start at 254; address 4 will hold each result.

memory 0100 {
    3A 03 00           // 0100: LDA 0003H: load the starting byte once.
    C6 01              // 0103: ADI 1: add one and update carry.
    32 04 00           // 0105: STA 0004H: store the result, preserving carry.
    D2 03 01           // 0108: JNC 0103H: repeat only while carry is clear.
}

end 010B              // The lesson ends when JNC falls through; no HLT runs.
