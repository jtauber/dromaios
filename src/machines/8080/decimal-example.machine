ram 10000

cpu 8080 {
    A = 11  B = 22  C = 33  D = 44
    E = 55  H = 66  L = 77
    PC = 0200  SP = ABCD
    flags { S = 1  Z = 0  AC = 1  P = 0  CY = 1 }
    interruptEnabled = true
    interruptDeferred = false
    halted = false
}

// Packed-decimal addition: 0999 + 0199 = 1198.
memory 0200 {
    3E 99       // MVI A,99H: low two digits of the first operand
    C6 99       // ADI 99H: binary result 32, AC = 1, CY = 1
    27          // DAA: decimal result 98, keep CY = 1
    32 80 00    // STA 0080H: save the low two result digits
    3E 09       // MVI A,09H: high two digits, preserving carry
    CE 01       // ACI 01H: high digits plus decimal carry, giving 0B
    27          // DAA: correct 0B to decimal 11
    32 81 00    // STA 0081H: result bytes are 98 11
    76          // HLT
}
