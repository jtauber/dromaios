// Receive one byte, then echo it to the separate lamp device.
components {
    ram = ram 10000
    input = byte-input
    output = byte-output
}

cpu 8080 {
    A = 00  B = 00  C = 00  D = 00  E = 00  H = 00  L = 00
    PC = 0100  SP = 0000
    flags { S = 0  Z = 0  AC = 0  P = 0  CY = 0 }
    interruptEnabled = false  interruptDeferred = false  halted = false
}

memory = ram
ports {
    in 01 = input 1
    out 01 = output 0
}

image ram 0100 {
    DB 01              // 0100: IN 01 — receive the pending byte into A.
    D3 01              // 0102: OUT 01 — send A to the lamp device.
}

end 0104              // Lesson boundary, not a halt instruction.
reset { cpu input output }
