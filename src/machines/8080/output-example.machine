// Send HELLO and newline to a host-bound byte output.

components {
    ram = ram 10000
    output = byte-output
}

cpu 8080 {
    A = 00  B = 00  C = 00  D = 00  E = 00  H = 00  L = 00
    PC = 0000  SP = 0000
    flags { S = 0  Z = 0  AC = 0  P = 0  CY = 0 }
    interruptEnabled = false  interruptDeferred = false  halted = false
}

memory = ram

ports {
    out 01 = output 0
}

image ram 0000 {
    21 00 01            // 0000: LXI H,0100 — message in RAM.
    06 06               // 0003: MVI B,06 — six bytes.
    7E                  // 0005: MOV A,M
    D3 01               // 0006: OUT 01
    23                  // 0008: INX H
    05                  // 0009: DCR B
    C2 05 00            // 000A: JNZ 0005
    76                  // 000D: HLT
}

image ram 0100 { 48 45 4C 4C 4F 0A } // HELLO\n

reset { cpu output }
