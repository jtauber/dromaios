ram 10000

cpu 6502 {
    A = 11  X = 22  Y = 33
    PC = 0200  SP = AB
    flags { N = 1  V = 1  D = 1  I = 1  Z = 1  C = 1 }
}

memory 007F { AA C0 02 55 } // Status byte at 0080; loop limit at 0081
memory 008F { AA CC 55 }    // Result at 0090
memory 017F { AA CC 55 }    // Stack slot at 0180

memory 0200 {
    D8          // CLD: enable binary ADC later
    A2 80       // LDX #$80
    9A          // TXS: choose the stack slot
    A9 01       // LDA #$01
    48          // PHA
    BA          // TSX: inspect SP after the push
    E0 7F       // CPX #$7F
    D0 24       // BNE $0230 (failure)
    A0 00       // LDY #$00
    C8          // Loop at 020E: INY
    C4 81       // CPY $81
    90 FB       // BCC $020E
    24 80       // BIT $80: N/V from C0; A & C0 is zero
    F0 03       // BEQ $021A
    4C 30 02    // JMP $0230 (failure)
    B8          // CLV
    50 03       // BVC $0220
    4C 30 02    // JMP $0230 (failure)
    68          // PLA: restore A from the chosen stack slot
    38          // SEC
    69 01       // ADC #$01: 1 + 1 + carry = 3
    F8          // SED: supported non-arithmetic operations still work
    EA          // NOP
    8D 90 00    // STA $0090
    4C 40 02    // JMP $0240 (completion)
}

memory FFFC { 00 02 } // Reset vector

end 0240
