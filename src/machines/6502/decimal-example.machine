ram 10000

cpu 6502 {
    A = 11  X = 22  Y = 33
    PC = 0200  SP = FF
    flags { N = 0  V = 1  D = 0  I = 0  Z = 1  C = 1 }
}

memory 007F { AA 99 99 01 00 CC CC CC CC 55 }
// 0080–0081: 9999; 0082–0083: 0001 (packed decimal, low byte first)
// 0084–0085: sum; 0086–0087: difference

memory 0200 {
    F8          // SED
    18          // CLC: begin 9999 + 0001
    A5 80       // LDA $80
    65 82       // ADC $82: 99 + 01 = 00, carry set
    85 84       // STA $84
    A5 81       // LDA $81: preserve carry from the low byte
    65 83       // ADC $83: 99 + 00 + carry = 00, carry set
    85 85       // STA $85: sum is 0000 with carry out
    38          // SEC: begin 0000 - 0001 with no incoming borrow
    A5 84       // LDA $84
    E5 82       // SBC $82: 00 - 01 = 99, carry clear (borrow)
    85 86       // STA $86
    A5 85       // LDA $85: preserve borrow from the low byte
    E5 83       // SBC $83: 00 - 00 - borrow = 99, carry clear
    85 87       // STA $87: difference is 9999 with borrow out
    D8          // CLD: return to binary arithmetic
}

memory FFFC { 00 02 }

end 021C
