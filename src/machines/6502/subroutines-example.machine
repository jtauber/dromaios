ram 10000

cpu 6502 {
    A = 11  X = 22  Y = 33
    PC = 0200  SP = 01
    flags { N = 0  V = 1  D = 0  I = 0  Z = 1  C = 1 }
}

memory 007F { AA CC 55 } // Result at 0080, with neighbors to preserve
memory 0102 { 5A }       // Above the first push
memory 01FC { A5 }       // Below the deepest call

memory 0200 {
    A9 80       // LDA #$80
    48          // PHA
    20 20 02    // JSR $0220
    8D 80 00    // STA $0080
    68          // PLA
    4C 40 02    // JMP $0240
    A9 EE       // Skipped LDA #$EE
}

memory 0220 {
    A9 05       // LDA #$05
    18          // CLC
    20 30 02    // JSR $0230
    69 01       // ADC #$01
    60          // RTS
}

memory 0230 {
    69 0A       // ADC #$0A
    60          // RTS
}

memory FFFC { 00 02 }    // Reset vector: 0200, low byte first

end 0240
